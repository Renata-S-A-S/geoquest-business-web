# Backend GeoQuest API. El módulo Business todavía no existe (slice
# 004-business-rewards arranca 29 ago 2026) — mientras tanto se usa
# VITE_USE_MOCKS para trabajar contra MSW + localStorage. Ver
# contratos-portal-b2b.md para el contrato que consume este cliente.
VITE_API_BASE_URL=http://localhost:5219

# Mock-first (ADR-048 borrador): true mientras el backend de Business no
# exista. Default explícito acá y en las variables de entorno de Vercel —
# si este flag queda mal puesto, el deploy se ve en blanco sin avisar por
# qué (ver Paso 3.3 del plan).
VITE_USE_MOCKS=true
